{
  "outputDirectory": "dist",
  "trailingSlash": true,
  "buildCommand": "",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
        "src": "/stock/(.*)",
        "dest": "/stocks/$1",
        "statusCode": 301
    },
    {
      "src": "/data/(.*)",
      "dest": "/data/$1"
    },
    {
      "src": "/about",
      "dest": "/about/index.html"
    },
    {
      "src": "/about/",
      "dest": "/about/index.html"
    },
    {
      "src": "/signal-vs-the-street",
      "dest": "/signal-vs-the-street.html"
    },
    {
      "src": "/signal-vs-the-street/",
      "dest": "/signal-vs-the-street.html"
    },
    {
        "src": "/hiv",
        "dest": "/hive/",
        "statusCode": 301
    },
    {
        "src": "/hiv/",
        "dest": "/hive/",
        "statusCode": 301
    },
    {
      "src": "/premium/success/?",
      "dest": "/premium/success.html"
    },
    {
      "src": "/premium",
      "dest": "/premium/index.html"
    },
    {
      "src": "/premium/",
      "dest": "/premium/index.html"
    },
    {
        "src": "/art/(.*)",
        "dest": "/article/$1",
        "statusCode": 301
    },
    {
      "src": "/article/(.*)",
      "dest": "/article/$1/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(?i).*text/html.*"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}